{
  "name": "@getpaseo/arena-proxy",
  "version": "0.4.0-beta.1",
  "private": true,
  "description": "Blinded OpenRouter proxy for Paseo Arena battles",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json --incremental false",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@getpaseo/protocol": "0.4.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  }
}
